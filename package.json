{
  "name": "moskas-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:brain": "node scripts/build-brain.mjs",
    "dev": "npm run prepare:brain && vite",
    "build": "npm run prepare:brain && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "audit:public": "node scripts/audit-public.mjs",
    "test": "vitest run",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && npm test && npm run build && playwright test && npm run audit:public",
    "test:e2e:install": "playwright install chromium --no-shell",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:live": "npm run build && node scripts/test-live.mjs",
    "test:e2e:outage": "npm run build && node scripts/test-live.mjs tests/e2e/outage.live.spec.ts"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.1.32",
    "@types/node": "^22.18.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  }
}
